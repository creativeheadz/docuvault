POSTGRES_DB=docuvault
POSTGRES_USER=docuvault
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://docuvault:change_me@postgres:5432/docuvault
DATABASE_URL_SYNC=postgresql://docuvault:change_me@postgres:5432/docuvault
SECRET_KEY=change-this-to-a-random-secret
ENCRYPTION_KEY=generate-a-base64-encoded-32-byte-key
SEED_USERNAME=andrei.trimbitas
SEED_PASSWORD=change_me
CORS_ORIGINS=http://localhost:3000

# Set to "production" on any instance that is reachable from outside the
# machine. It hides the interactive API schema and refuses to start if
# SECRET_KEY, ENCRYPTION_KEY or SEED_PASSWORD still hold the built-in
# development values.
#   SECRET_KEY     python -c "import secrets; print(secrets.token_urlsafe(64))"
#   ENCRYPTION_KEY python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Rotating ENCRYPTION_KEY makes every stored secret undecryptable - re-key
# before the vault has anything in it, or write a re-encryption migration.
ENVIRONMENT=development

# Hosts outbound requests may reach despite resolving into private address
# space, e.g. an Uptime Kuma on the LAN. Comma-separated, names or IPs.
OUTBOUND_ALLOWED_HOSTS=

# AI-powered Systems documentation chat (optional)
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# MemPalace MCP server (optional). FastMCP HTTP+SSE, bearer-auth.
MEMPALACE_URL=
MEMPALACE_TOKEN=
